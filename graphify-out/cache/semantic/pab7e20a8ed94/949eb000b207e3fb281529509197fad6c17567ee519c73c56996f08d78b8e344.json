{"nodes": [{"id": "readme_totalsegmentator", "label": "TotalSegmentator (==2.16.0)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_cca", "label": "Common Carotid Artery (CCA)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_ica", "label": "Internal Carotid Artery (ICA)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_eca", "label": "External Carotid Artery (ECA)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ECA is not present in any TotalSegmentator task and must be reconstructed via rule-based vessel-tree analysis (Frangi vesselness + skeletonization + bifurcation labeling) rather than a direct model output."}, {"id": "readme_total_task", "label": "TotalSegmentator 'total' task", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_headneck_bones_vessels_task", "label": "TotalSegmentator 'headneck_bones_vessels' task", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_frangi_vesselness", "label": "Frangi Vesselness Filtering", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_bifurcation_detection", "label": "Rule-based Bifurcation Detection & Branch Labeling", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Assumes standard bifurcation anatomy: one branch continues to the known ICA seed, one to the known CCA seed, the rest is ECA. Severe tortuosity, occlusion, or a very high/low bifurcation may break this rule; in that case the case falls back to the raw TotalSegmentator CCA/ICA masks with bifurcation_found: false and no ECA, rather than guessing."}, {"id": "readme_carotid_conda_env", "label": "'carotid' conda environment (TotalSegmentator, torch, nibabel, scikit-image, scipy, networkx, dicom2nifti, SimpleITK, nnunetv2)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_run_batch", "label": "run_batch.py (CLI entrypoint)", "file_type": "code", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_summary_json", "label": "summary.json (per-case QA output)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_carotid_seg_totalseg_steps", "label": "carotid_seg/totalseg_steps.py (TotalSegmentator task wrappers: CCA, ICA, styloid, C1-C7 landmarks)", "file_type": "code", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_carotid_seg_vesselness", "label": "carotid_seg/vesselness.py (adaptive HU banding + Frangi vessel lumen extraction)", "file_type": "code", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_carotid_seg_vesselness_adaptive_lumen_hu_band", "label": "adaptive_lumen_hu_band() (carotid_seg/vesselness.py)", "file_type": "code", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "HU band is adaptive but not bulletproof; if a case's ECA comes out under- or over-segmented, this threshold is one of the first things to tune."}, {"id": "readme_carotid_seg_vesselness_vessel_lumen_mask", "label": "vessel_lumen_mask() / frangi_thresh (carotid_seg/vesselness.py)", "file_type": "code", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Frangi threshold (frangi_thresh) is adaptive but not bulletproof; along with the morphological closing radius (ball(1)), it is a first tuning knob if ECA segmentation quality is poor."}, {"id": "readme_carotid_seg_treeanalysis", "label": "carotid_seg/treeanalysis.py (skeleton graph, cycle-artifact cleanup, bifurcation search, branch labeling)", "file_type": "code", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_carotid_seg_treeanalysis_bifurcation_apex_convention", "label": "Bifurcation-apex convention (label_vol[bn] = 1 in treeanalysis.py)", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The single voxel where CCA/ICA/ECA meet is counted as the end of the CCA. This is a convention, not a universal standard \u2014 clinically the 'carotid bulb' spans this zone loosely. Change the label_vol[bn] = 1 line in treeanalysis.py for a different convention."}, {"id": "readme_carotid_seg_volumize", "label": "carotid_seg/volumize.py (label propagation back to full volume + QA metrics)", "file_type": "code", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_carotid_seg_pipeline_py", "label": "carotid_seg/pipeline.py (per-case orchestration, left/right merge, NIfTI I/O)", "file_type": "code", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_carotid_seg_pipeline", "label": "Carotid Segmentation Pipeline (overall project)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_cta_requirement", "label": "Contrast-enhanced CTA input requirement", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Requires contrast-enhanced CT angiography (CTA), not plain CT, because adaptive HU banding and Frangi vesselness depend on the carotid lumen being bright relative to surrounding tissue; plain CT gives unreliable results with no way around it without contrast."}, {"id": "readme_fov_requirement", "label": "Field-of-view (FOV) requirement for CTA input", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "FOV should cover from below the CCA origin (roughly aortic-arch level) up through the skull base. If the scan doesn't include neck vertebrae C1-C7, summary.json's vertebrae_found list for that case will be short/empty, flagging insufficient FOV."}, {"id": "readme_nnunetv2_finetune_plan", "label": "Future nnU-Net v2 fine-tuning fallback plan", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No fine-tuned model is currently used. If the rule-based approach isn't accurate enough after tuning, the natural next step (nnunetv2 already in the env) is to hand-label a training set from this pipeline's output (after manual correction) and fine-tune a dedicated 3-class carotid model."}, {"id": "readme_skull_base_capping_option", "label": "--cap-ica-at-skull-base option", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Off by default, since headneck_bones_vessels's ICA model has its own learned extent and the styloid-process landmark is only an approximation of true skull-base (carotid canal) entry. Turn on and tune --skull-base-margin-mm if the raw ICA output runs further than desired."}, {"id": "readme_output_label_scheme", "label": "Multilabel NIfTI output scheme (1=CCA right, 2=CCA left, 3=ICA right, 4=ICA left, 5=ECA right, 6=ECA left)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_status_validation", "label": "Validation status (synthetic Y-shaped geometry only, not yet real CTA)", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Image-processing logic is implemented and validated against synthetic Y-shaped vessel geometry (verified correct on controlled data), but has not yet been run on a real CT angiography case. Before trusting output clinically or for downstream modeling (e.g. CFD, stenosis measurement), run on real cases and check QA numbers in summary.json plus visual review in ITK-SNAP / 3D Slicer / SimVascular."}], "edges": [{"source": "readme_totalsegmentator", "target": "readme_total_task", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_totalsegmentator", "target": "readme_headneck_bones_vessels_task", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "sou